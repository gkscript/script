<!--
  Profile menu. Same window system as the result window (src/lib/Theme.xaml, injected at
  the THEME placeholder): 600 px, a Netixx-blue band that also colors the title bar, app mark +
  32 px headline + subline, calm Mica below, translucent-white Windows 11 settings-card rows.
  Background is the solid fallback; Enable-WindowBackdrop swaps it for Mica on Windows 11 22H2+.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Icon="{Binding IconPath}"
        Width="600" SizeToContent="Height" MaxHeight="800"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#F3F3F3" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#1A1A1A">
    <Window.Resources>
        <!--THEME-->
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- Band: Netixx blue (white text 6.7:1, subline 5.4:1) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Band}" Background="{StaticResource NetixxBlueDeep}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- App mark sits where the result window shows its status mark -->
                <Image Grid.Column="0" Source="{Binding IconPath}" Width="60" Height="60"
                       Margin="0,0,22,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BandTitle}" Text="Netixx Grundkonfiguration"/>
                    <TextBlock Style="{StaticResource BandSubtitle}" Foreground="#DCE6FF" Text="{Binding Subtitle}"/>
                    <!-- A newer release exists on GitHub (set in the background); the link downloads it -->
                    <TextBlock Visibility="{Binding UpdateVisibility}" Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold">
                        <Hyperlink NavigateUri="{Binding DownloadUrl}" Foreground="#FFFFFF"
                                   AutomationProperties.AutomationId="UpdateLink">
                            <Run Text="{Binding UpdateText}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                <!-- Language: quiet chips in the band's top-right corner (Tag = language code).
                     Codes are language-neutral, so they stay the same in every language. -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-20,-18,0">
                    <RadioButton Style="{StaticResource LanguageChip}" Content="DE" Tag="de"
                                 IsChecked="{Binding IsDe, Mode=OneWay}" ToolTip="Deutsch"
                                 AutomationProperties.Name="Deutsch" AutomationProperties.AutomationId="LangDe"/>
                    <RadioButton Style="{StaticResource LanguageChip}" Content="EN" Tag="en"
                                 IsChecked="{Binding IsEn, Mode=OneWay}" ToolTip="English"
                                 AutomationProperties.Name="English" AutomationProperties.AutomationId="LangEn"/>
                    <RadioButton Style="{StaticResource LanguageChip}" Content="IT" Tag="it"
                                 IsChecked="{Binding IsIt, Mode=OneWay}" ToolTip="Italiano"
                                 AutomationProperties.Name="Italiano" AutomationProperties.AutomationId="LangIt"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" TextAlignment="Center"
                   Margin="32,10,32,22" Text="{Binding Footer}"/>

        <!-- Run options: one card, same surface as the profile rows; a hairline between the rows.
             Tag = the menu state key the switch sets ({mode} / {updates} in gui.csv). -->
        <Border DockPanel.Dock="Bottom" Margin="32,8,32,0" Padding="18,4,16,4"
                CornerRadius="{StaticResource ControlCorner}" Background="{StaticResource ControlFill}"
                BorderBrush="{StaticResource ControlStroke}" BorderThickness="1">
            <StackPanel>
                <!-- On passes -InstallOnly: only installs, removes nothing -->
                <CheckBox Style="{StaticResource ToggleSwitch}" Tag="InstallOnly"
                          IsChecked="{Binding InstallOnly, Mode=OneWay}"
                          AutomationProperties.Name="{Binding InstallOnlyLabel}" AutomationProperties.HelpText="{Binding InstallOnlyHint}"
                          AutomationProperties.AutomationId="InstallOnlySwitch">
                    <StackPanel Margin="0,8">
                        <TextBlock Text="{Binding InstallOnlyLabel}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding InstallOnlyHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
                <Border Height="1" Background="{StaticResource ControlStroke}" Margin="0,0,-16,0"/>
                <!-- Off passes -SkipUpdates -->
                <CheckBox Style="{StaticResource ToggleSwitch}" Tag="UpdatesEnabled"
                          IsChecked="{Binding UpdatesEnabled, Mode=OneWay}"
                          AutomationProperties.Name="{Binding UpdatesLabel}" AutomationProperties.HelpText="{Binding UpdatesHint}"
                          AutomationProperties.AutomationId="UpdatesSwitch">
                    <StackPanel Margin="0,8">
                        <TextBlock Text="{Binding UpdatesLabel}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UpdatesHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- Profiles -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl ItemsSource="{Binding MenuItems}" Margin="32,24,32,8" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ProfileRow}"
                                Tag="{Binding Reference}"
                                AutomationProperties.Name="{Binding AccessibleName}"
                                AutomationProperties.HelpText="{Binding Description}"
                                AutomationProperties.AutomationId="{Binding Reference}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Icon column of gui.csv -->
                                <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" Visibility="{Binding IconVisibility}"
                                           Style="{StaticResource InlineIcon}" FontSize="22"
                                           Foreground="{StaticResource NetixxBlueDeep}"
                                           VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ButtonText}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource InlineIcon}"
                                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
