{
  "logging": {
    "logPath": "C:\\Logs\\PSScriptSetup"
  },
  "deployment": {
    "business": {
      "name": "Business",
      "packages": ["vlc", "firefox", "googlechrome", "7zip", "adobereader", "powertoys"],
      "branded": true,
      "oemFirmware": true
    },
    "consumer": {
      "name": "Consumer",
      "packages": ["vlc", "firefox", "googlechrome", "7zip", "adobereader", "libreoffice", "paint.net", "outlook", "powertoys"],
      "branded": true
    },
    "consumer-nolo": {
      "name": "Consumer (No LibreOffice)",
      "packages": ["vlc", "firefox", "googlechrome", "7zip", "adobereader", "paint.net", "outlook", "powertoys"],
      "branded": true
    }
  },
  "packageCatalog": {
    "_comment": "winget first (vendor installers, hash-checked); Chocolatey only if winget fails. {uilang} = Windows display language (de/it/...); IDs are tried in order.",
    "vlc":          { "winget": ["VideoLAN.VLC"], "choco": "vlc" },
    "firefox":      { "winget": ["Mozilla.Firefox.{uilang}", "Mozilla.Firefox"], "choco": "firefox" },
    "googlechrome": { "winget": ["Google.Chrome.EXE"], "wingetArgs": "--scope machine", "choco": "googlechrome" },
    "7zip":         { "winget": ["7zip.7zip"], "choco": "7zip" },
    "adobereader":  { "winget": ["Adobe.Acrobat.Reader.64-bit"], "choco": "adobereader", "chocoParams": "/UpdateMode:3 /EnableUpdateService" },
    "libreoffice":  { "winget": ["TheDocumentFoundation.LibreOffice"], "choco": "libreoffice-still" },
    "paint.net":    { "winget": ["dotPDN.PaintDotNet"], "choco": "paint.net" },
    "powertoys":    { "winget": ["Microsoft.PowerToys"], "wingetArgs": "--scope machine", "choco": "powertoys" },
    "nvidia-app":   { "winget": ["XP8CLZL93F5Z4P"], "wingetSource": "msstore", "choco": "nvidia-app" },
    "outlook":      { "winget": ["9NRX63209R7B"], "wingetSource": "msstore", "appx": "Microsoft.OutlookForWindows" }
  },
  "paths": {
    "installFolder": "C:\\Install"
  },
  "windows": {
    "shortcuts": [
      "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\Angebote.lnk",
      "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\Firefox Privater Modus.lnk",
      "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\Amazon.com.lnk",
      "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\HP Documentation.lnk",
      "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\HP Sure Click Pro Secure Browser.lnk",
      "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\TCO Certified.lnk",
      "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\Booking.lnk",
      "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\LastPass.lnk"
    ],
    "_taskbarPins": "Start-menu shortcut names pinned to the taskbar after the default pins (and kept off the desktop)",
    "taskbarPins": ["Google Chrome.lnk", "Firefox.lnk"]
  },
  "office": {
    "_comment": "office.ps1 (own menu item). The product must match the customer's licence - Microsoft: 'If you use the wrong product ID, you can't activate Office' (Learn: Product IDs supported by the ODT). oneDrive: the subscription includes OneDrive storage. setupUrl: the current ODT setup.exe, downloaded and signature-checked for each run (also used by the full run's Office removal).",
    "setupUrl": "https://officecdn.microsoft.com/pr/wsus/setup.exe",
    "products": [
      { "key": "m365business",     "productId": "O365BusinessRetail",     "oneDrive": true },
      { "key": "homebusiness2024", "productId": "HomeBusiness2024Retail", "oneDrive": false },
      { "key": "home2024",         "productId": "Home2024Retail",         "oneDrive": false },
      { "key": "m365home",         "productId": "O365HomePremRetail",     "oneDrive": true }
    ],
    "excludeApps": ["Groove", "Lync", "Publisher"],
    "proofingLanguages": ["de-de", "it-it"]
  },
  "release": {
    "_comment": "The menu compares src/version.txt with the latest GitHub release and links the download.",
    "latestApi": "https://api.github.com/repos/gkscript/script/releases/latest",
    "downloadUrl": "https://github.com/gkscript/script/releases/latest/download/gk-script.exe"
  },
  "validation": {
    "minDiskSpace": 5000000000
  }
}
