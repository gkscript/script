Windows Registry Editor Version 5.00

; Machine-wide settings (all users). Values from Win11Debloat (Regfiles/, 2026-10) and
; Microsoft's policy definitions (local PolicyDefinitions\*.admx); supported on Windows 11 Pro.
; Keep this file ASCII: reg.exe accepts ANSI or UTF-16 LE, never UTF-8 with BOM.

; Widgets (News and interests) - Policy CSP NewsAndInterests/AllowNewsAndInterests
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Dsh]
"AllowNewsAndInterests"=dword:00000000

; Recall and Click to Do on Copilot+ PCs (opt-in by default; this keeps them off)
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WindowsAI]
"AllowRecallEnablement"=dword:00000000
"DisableAIDataAnalysis"=dword:00000001
"TurnOffSavingSnapshots"=dword:00000001
"DisableClickToDo"=dword:00000001

; Microsoft Edge: no ads, shopping assistant, sponsored tiles, default-browser nags.
; HideFirstRunExperience=1 skips the first-run wizard (Microsoft Edge policy docs).
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"NewTabPageContentEnabled"=dword:00000000
"NewTabPageHideDefaultTopSites"=dword:00000001
"EdgeShoppingAssistantEnabled"=dword:00000000
"TabServicesEnabled"=dword:00000000
"AlternateErrorPagesEnabled"=dword:00000000
"UserFeedbackAllowed"=dword:00000000
"ShowRecommendationsEnabled"=dword:00000000
"WalletDonationEnabled"=dword:00000000
"HideFirstRunExperience"=dword:00000001
"DefaultBrowserSettingEnabled"=dword:00000000
"DefaultBrowserSettingsCampaignEnabled"=dword:00000000
"SpotlightExperiencesAndRecommendationsEnabled"=dword:00000000
"ShowAcrobatSubscriptionButton"=dword:00000000

; Storage Sense (policy, StorageSense.admx): on, weekly; temp files cleaned; recycle bin
; after 30 days; Downloads never touched. As a policy it is shown as managed in Settings.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\StorageSense]
"AllowStorageSenseGlobal"=dword:00000001
"ConfigStorageSenseGlobalCadence"=dword:00000007
"AllowStorageSenseTemporaryFilesCleanup"=dword:00000001
"ConfigStorageSenseRecycleBinCleanupThreshold"=dword:0000001e
"ConfigStorageSenseDownloadsCleanupThreshold"=dword:00000000

; Fast Startup off: restart and shutdown behave the same, drivers and updates apply
; reliably (Win11Debloat Disable_Fast_Startup.reg)
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Power]
"HiberbootEnabled"=dword:00000000
