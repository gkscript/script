<!--
THESIS: The end of a run is a signal read from across the room, not a dialog read up close.
  Refuses the stock MessageBox: small icon, paragraph, OK button.
OWN-WORLD: The gk-script window system (src/lib/Theme.xaml), shared with the profile menu:
  a solid band (here the status color: green done / yellow warnings / red failed) that also
  colors the title bar, a large Segoe Fluent mark, a Segoe UI Variable Display headline;
  calm Mica below; translucent-white controls; Netixx blue for the one accent action.
STORY: The technician walks back in, knows the outcome from the color alone, walks up, reads what
  needs attention, then opens the log, restarts, or closes.
FIRST VIEWPORT: 600 px wide. Status band on top, mark left of a 32 px headline with one subline
  (profile / machine / duration). Below: what needs attention (or that nothing does), a restart
  line when drivers need it, the log path. Buttons bottom right: Open log, Restart now, Close.
FORM: Extension of the existing menu surface: inherits its world (Netixx blue, Segoe, Win11).
  No concept-seed roll: new-work.md, "Never run the script for a local extension or a precisely
  specified narrow request" - the brief fixed the job (success/warnings/failed, across the room). No seed key.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Netixx Grundkonfiguration" Width="600" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#F3F3F3" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#1A1A1A">
    <Window.Resources>
        <!--THEME-->
    </Window.Resources>

    <StackPanel>
        <!-- Status band: the color is the message -->
        <Border x:Name="Band" Style="{StaticResource Band}" Background="#107C10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Glyph" Grid.Column="0" Style="{StaticResource BandMark}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource BandTitle}" Text="Setup complete"/>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource BandSubtitle}" Foreground="#DFF6DD"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Details -->
        <StackPanel Margin="32,24,32,0">
            <TextBlock x:Name="SectionHeading" Style="{StaticResource SectionHeading}"/>
            <ScrollViewer x:Name="ItemsScroll" MaxHeight="232" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="ItemsList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE7BA;" Style="{StaticResource InlineIcon}"
                                           Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" LineHeight="19"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Shown only when Windows Update drivers need a reboot and warnings are listed -->
            <Grid x:Name="RestartRow" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE777;" Style="{StaticResource InlineIcon}"
                           Foreground="{StaticResource NetixxBlueDeep}"/>
                <TextBlock Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="Restart the PC to finish installing drivers."/>
            </Grid>

            <!-- Log path: selectable so it can be copied -->
            <Grid x:Name="LogRow" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Log" Style="{StaticResource Caption}" Margin="0,0,10,0"/>
                <TextBox x:Name="LogPath" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Padding="0"
                         Background="Transparent" FontSize="12" Foreground="{StaticResource TextSecondary}"
                         TextWrapping="Wrap" SelectionBrush="{StaticResource NetixxBlue}" IsTabStop="False"
                         AutomationProperties.Name="Log file path"/>
            </Grid>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="32,22,32,26">
            <Button x:Name="OpenLogButton" Content="Open log" Style="{StaticResource ActionButton}"
                    AutomationProperties.AutomationId="OpenLog"/>
            <Button x:Name="RestartButton" Content="Restart now" Style="{StaticResource AccentButton}"
                    Visibility="Collapsed" AutomationProperties.AutomationId="RestartNow"/>
            <Button x:Name="CloseButton" Content="Close" Style="{StaticResource ActionButton}"
                    IsCancel="True" AutomationProperties.AutomationId="Close"/>
        </StackPanel>
    </StackPanel>
</Window>
